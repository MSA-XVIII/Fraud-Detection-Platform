# =============================================================================
# Real-Time Fraud Detection Platform — CONFIGURATION
# -----------------------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file to ".env"   ->   cp .env.example .env
#   2. Fill in the values marked  <<< PASTE ... >>>  below.
#   3. Anything left blank uses a safe LOCAL fallback (no cloud needed).
#
# Every capability degrades gracefully: with NO keys the whole system runs
# locally; adding keys transparently upgrades LLM / tracing / graph / vector.
# =============================================================================


# -----------------------------------------------------------------------------
# [1] ENVIRONMENT
# -----------------------------------------------------------------------------
APP_ENV=local                 # local | staging | prod
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# [2] KAFKA / REDPANDA  (streaming bus)   — LOCAL by default via docker compose
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_RAW_TOPIC=raw-transactions
KAFKA_DLQ_TOPIC=raw-transactions-dlq
KAFKA_CONSUMER_GROUP=fraud-stream
# If you switch to Confluent Cloud, set SASL creds below (leave blank for local):
KAFKA_SECURITY_PROTOCOL=          # e.g. SASL_SSL
KAFKA_SASL_MECHANISM=             # e.g. PLAIN
KAFKA_SASL_USERNAME=              # <<< PASTE Confluent API key (optional) >>>
KAFKA_SASL_PASSWORD=              # <<< PASTE Confluent API secret (optional) >>>


# -----------------------------------------------------------------------------
# [3] MONGODB  (serving store)   — LOCAL by default via docker compose
# -----------------------------------------------------------------------------
# Local docker:  mongodb://root:example@localhost:27017
# Atlas cloud :  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URI=mongodb://root:example@localhost:27017
MONGO_DB=fraud
MONGO_USE_ATLAS_VECTOR=false     # true -> use Atlas Vector Search instead of local FAISS


# -----------------------------------------------------------------------------
# [4] NEO4J AURA  (graph store — CLOUD CLUSTER)   *** REQUIRED ***
# -----------------------------------------------------------------------------
# Create a free/paid AuraDB instance at https://console.neo4j.io
# When the instance is created you are shown a connection URI + generated
# password (download the .txt credentials file). Paste them here.
#
#   URI format:  neo4j+s://<dbid>.databases.neo4j.io
#
NEO4J_URI=                       # <<< PASTE Aura URI, e.g. neo4j+s://xxxx.databases.neo4j.io >>>
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=                  # <<< PASTE Aura generated password >>>
NEO4J_DATABASE=neo4j
NEO4J_USE_GDS=false              # true if your Aura tier includes Graph Data Science (else networkx fallback)


# -----------------------------------------------------------------------------
# [5] MLFLOW  (model tracking + registry)   — LOCAL by default via docker compose
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=fraud-scoring
MLFLOW_MODEL_NAME=fraud-scorer
MLFLOW_MODEL_ALIAS=Production


# -----------------------------------------------------------------------------
# [6] LLM PROVIDER  (analyst-assist layer — OFF the hot path)
# -----------------------------------------------------------------------------
# Leave keys blank -> deterministic FakeListLLM fallback (tests & demo run offline).
# LangChain orchestrates ALL providers below (summary / RAG / agent chains).
LLM_PROVIDER=fake                # fake | openai | anthropic | finetuned
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=                  # <<< PASTE OpenAI key (optional) >>>
ANTHROPIC_API_KEY=               # <<< PASTE Anthropic key (optional) >>>


# -----------------------------------------------------------------------------
# [6b] FINE-TUNED LLM  (analyst-feedback loop -> fine-tune -> serve via LangChain)
# -----------------------------------------------------------------------------
# The dashboard captures 👍/👎 on each summary. `make finetune` exports those
# grounded, thumbs-up summaries to a JSONL dataset and trains a model:
#   * If OPENAI_API_KEY is set -> submits an OpenAI fine-tuning job; paste the
#     resulting model id (ft:gpt-...) into FINETUNED_MODEL_ID and set
#     LLM_PROVIDER=finetuned.
#   * Otherwise -> local LoRA/PEFT fine-tune of FINETUNE_BASE_MODEL; the adapter
#     is written to FINETUNE_OUTPUT_DIR and loaded via LangChain HuggingFacePipeline.
FINETUNE_MODE=auto               # auto | openai | local
FINETUNE_BASE_MODEL=distilgpt2   # local base model for LoRA fallback (light)
FINETUNE_OUTPUT_DIR=./models/finetuned
FINETUNE_DATASET_PATH=./data/finetune/analyst_summaries.jsonl
FINETUNE_MIN_EXAMPLES=10         # minimum thumbs-up examples before training
FINETUNED_MODEL_ID=              # <<< PASTE ft:gpt-... id, OR local adapter path >>>


# -----------------------------------------------------------------------------
# [7] LANGSMITH  (LLM observability / tracing / eval)   — no-op if blank
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=               # <<< PASTE LangSmith key (optional) >>>
LANGCHAIN_PROJECT=fraud-analyst


# -----------------------------------------------------------------------------
# [8] EMBEDDINGS  (vector search for RAG)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384


# -----------------------------------------------------------------------------
# [9] SCORING THRESHOLDS  (risk banding)
# -----------------------------------------------------------------------------
RISK_HIGH_THRESHOLD=0.80          # >= high  -> auto-flag
RISK_MEDIUM_THRESHOLD=0.50        # >= medium -> queue for review
MODEL_RELOAD_SECONDS=60           # hot-reload Production model from registry


# -----------------------------------------------------------------------------
# [10] DATA / LAKEHOUSE
# -----------------------------------------------------------------------------
DATA_DIR=./data
BRONZE_DIR=./data/bronze
SILVER_DIR=./data/silver
GOLD_DIR=./data/gold
